{
  "name": "p2-orchestrator",
  "version": "0.1.0",
  "description": "Process Orchestrator — Walking Skeleton",
  "type": "module",
  "scripts": {
    "skeleton": "tsx walking-skeleton.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "agent:crm": "tsx src/agents/crm-agent.ts",
    "agent:email": "tsx src/agents/email-agent.ts",
    "agent:tracking": "tsx src/agents/tracking-agent.ts",
    "agents": "concurrently \"npm run agent:crm\" \"npm run agent:email\" \"npm run agent:tracking\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bullmq": "^5.77.3",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "mongodb": "^6.16.0",
    "openai": "^6.42.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
